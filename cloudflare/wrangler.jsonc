{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aforo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": false,
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": false },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/proyecto/aforo", "/proyecto/aforo/", "/proyecto/aforo/api/*"]
  },
  "vars": { "DEMO_ENABLED": "true", "PUBLIC_ORIGIN": "https://www.pedrogomez.dev" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aforo-db",
    "database_id": "34623031-7607-4c3a-984f-2569f175eb5e",
    "migrations_dir": "migrations"
  }]
}
